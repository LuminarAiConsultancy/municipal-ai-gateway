# Municipal AI Gateway — Production Environment Template
# Copy to .env and fill in real values. NEVER commit .env to git.
#
# Pre-deployment checklist:
# [ ] GATEWAY_SECRET changed from default
# [ ] POSTGRES_PASSWORD changed from default
# [ ] DATABASE_URL uses +asyncpg driver
# [ ] At least one AI provider API key configured
# [ ] TLS certificates generated (see nginx/ directory)

# ── Gateway ──────────────────────────────────────────
# Admin secret for dashboard and /admin/* endpoints.
# Generate with: openssl rand -hex 32
GATEWAY_SECRET=CHANGE_ME_TO_A_RANDOM_64_HEX_STRING

# ── Database ─────────────────────────────────────────
POSTGRES_USER=gateway
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_48_HEX_STRING
POSTGRES_DB=ai_gateway
DATABASE_URL=postgresql+asyncpg://gateway:CHANGE_ME_TO_A_RANDOM_48_HEX_STRING@db:5432/ai_gateway

# ── AI Provider API Keys ─────────────────────────────
# Set only the providers you use. Leave others blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── CORS ─────────────────────────────────────────────
# Comma-separated allowed origins. Default: http://localhost:8080,https://localhost
CORS_ORIGINS=https://your-domain.ca

# ── Logging ──────────────────────────────────────────
# json (default, structured) or console (human-readable)
LOG_FORMAT=json
LOG_LEVEL=info

# ── PII Scrubbing ───────────────────────────────────
# fail_closed (default, return 503) or fail_open (forward without scrubbing)
SCRUBBER_FAILURE_MODE=fail_closed

# ── French NLP ───────────────────────────────────────
# Set to true to enable French PII detection (~500 MB extra RAM).
# Requires fr_core_news_lg spacy model in the Docker image.
ENABLE_FRENCH_NLP=false

# ── Alerts (optional) ────────────────────────────────
# Webhook URL for alert notifications (Slack, Teams, etc.)
ALERT_WEBHOOK_URL=
# Email address for alert notifications
ALERT_EMAIL=
# SMTP settings (only needed if ALERT_EMAIL is set)
# SMTP_HOST=smtp.example.ca
# SMTP_PORT=587
# SMTP_FROM=gateway@example.ca

# ── Provincial Privacy Framework ─────────────────────
# Your province code: BC, AB, ON, or QC
PROVINCE=
