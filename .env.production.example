# Municipal AI Gateway — Production Environment Template
# Copy to .env and fill in real values. NEVER commit .env to git.

# ── Gateway ──────────────────────────────────────────
# Admin secret for dashboard and /admin/* endpoints.
# Generate with: openssl rand -hex 32
GATEWAY_SECRET=CHANGE_ME_TO_A_RANDOM_64_HEX_STRING

# ── Database ─────────────────────────────────────────
POSTGRES_USER=gateway
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_48_HEX_STRING
POSTGRES_DB=ai_gateway
DATABASE_URL=postgresql://gateway:CHANGE_ME_TO_A_RANDOM_48_HEX_STRING@db:5432/ai_gateway

# ── AI Provider API Keys ─────────────────────────────
# Set only the providers you use. Leave others blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
