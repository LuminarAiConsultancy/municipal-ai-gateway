# ──────────────────────────────────────────────
# Municipal AI Gateway — Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── Database ──────────────────────────────────
POSTGRES_USER=gateway
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ai_gateway
DATABASE_URL=postgresql+asyncpg://gateway:changeme@db:5432/ai_gateway

# ── AI Provider API Keys ─────────────────────
# Only configure the providers your organization uses.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Gateway Settings ─────────────────────────
GATEWAY_PORT=8080
LOG_LEVEL=info
