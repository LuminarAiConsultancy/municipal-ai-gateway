# Canadian Municipal AI Gateway - Environment Variables
# Copy this file to .env and fill in your values before starting the gateway.
#
# Variables marked REQUIRED must be set before the gateway will start.
# Variables marked OPTIONAL have sensible defaults and can be left as-is.

# ── Security ─────────────────────────────────────────

# REQUIRED. Protects the admin dashboard and all /admin API endpoints.
# Minimum 32 characters. Gateway refuses to start without this.
# Generate one by running: openssl rand -hex 32
GATEWAY_SECRET=

# REQUIRED. Database password. Must be changed before deploying.
POSTGRES_PASSWORD=

# REQUIRED. At least one AI provider API key.
# Leave unused providers blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Database ─────────────────────────────────────────

# OPTIONAL. Database username. Default: gateway
POSTGRES_USER=gateway

# OPTIONAL. Database name. Default: ai_gateway
POSTGRES_DB=ai_gateway

# OPTIONAL. Full connection string. Only change if you customized user/password/db above.
DATABASE_URL=postgresql+asyncpg://gateway:YOUR_POSTGRES_PASSWORD@db:5432/ai_gateway

# OPTIONAL. Connection pool tuning. Defaults work for most municipalities.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── Redis ────────────────────────────────────────────

# OPTIONAL. Redis connection URL for distributed rate limiting.
# Default works with Docker Compose out of the box.
RATE_LIMIT_REDIS_URL=redis://redis:6379/0

# OPTIONAL. Requests per minute per API key. Default: 60
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ── Gateway ──────────────────────────────────────────

# OPTIONAL. Port the gateway listens on. Default: 8080
GATEWAY_PORT=8080

# OPTIONAL. Log verbosity: debug, info, warning, error. Default: info
LOG_LEVEL=info

# OPTIONAL. Log output format: json (default) or console (human-readable).
LOG_FORMAT=json

# OPTIONAL. Number of days to retain request logs. Default: 365
LOG_RETENTION_DAYS=365

# OPTIONAL. Comma-separated allowed CORS origins.
CORS_ORIGINS=http://localhost:8080,https://localhost

# OPTIONAL. What to do when the scrubber fails: fail_closed (503) or fail_open (forward unscrubbed).
SCRUBBER_FAILURE_MODE=fail_closed

# OPTIONAL. Enable French NLP model for bilingual PII detection (~500 MB extra RAM).
ENABLE_FRENCH_NLP=false

# OPTIONAL. Your province code: BC, AB, ON, or QC.
# Maps PII detections to your province's privacy law.
PROVINCE=

# OPTIONAL. Webhook URL for alerts (PII spikes, budget warnings, chain failures).
ALERT_WEBHOOK_URL=

# OPTIONAL. Email address for alert notifications.
ALERT_EMAIL=

# OPTIONAL. Your server's public hostname (e.g. gateway.yourtown.ca).
# When set, Caddy obtains a Let's Encrypt certificate automatically.
# Leave as localhost for local development.
GATEWAY_DOMAIN=localhost

# OPTIONAL. Email for Let's Encrypt certificate notifications.
# Recommended for production so you receive expiry warnings.
CADDY_TLS_EMAIL=

# ── Backups ──────────────────────────────────────────

# OPTIONAL. Number of days to keep daily database backups. Default: 30
BACKUP_RETENTION_DAYS=30

# ── LDAP / Active Directory ─────────────────────────

# OPTIONAL. Enable LDAP authentication for staff key provisioning.
LDAP_ENABLED=false
LDAP_SERVER=
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_STARTTLS=true
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_DEPT_ATTRIBUTE=department

# ── Admin Accounts ──────────────────────────────────

# OPTIONAL. Bootstrap the first admin account on startup.
# If both are set and no admin with this email exists, the account is created automatically.
ADMIN_EMAIL=
ADMIN_PASSWORD=
