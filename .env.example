# Municipal AI Gateway - Environment Variables
# Copy this file to .env and fill in your values before starting the gateway.

# ── Admin Secret ────────────────────────────────────────
# Required. Protects the admin dashboard and all /admin API endpoints.
# Generate one by running: openssl rand -hex 32
GATEWAY_SECRET=replace-with-random-64-character-hex-string

# ── Database ────────────────────────────────────────────
# Optional. Database username. Default works with Docker Compose.
POSTGRES_USER=gateway

# Required. Database password. Change this from the default before deploying.
POSTGRES_PASSWORD=changeme

# Optional. Database name. Default works with Docker Compose.
POSTGRES_DB=ai_gateway

# Optional. Full connection string. If you changed POSTGRES_PASSWORD above,
# update the password in this URL to match.
DATABASE_URL=postgresql+asyncpg://gateway:changeme@db:5432/ai_gateway

# ── AI Provider API Keys ───────────────────────────────
# Configure at least one provider. Leave unused providers blank.

# Required if using OpenAI or ChatGPT. Get yours at platform.openai.com/api-keys
OPENAI_API_KEY=

# Required if using Anthropic or Claude. Get yours at console.anthropic.com
ANTHROPIC_API_KEY=

# Required if using Google or Gemini. Get yours at aistudio.google.com/apikey
GOOGLE_API_KEY=

# ── Redis (Rate Limiting) ──────────────────────────────
# Optional. Redis connection URL for distributed rate limiting.
# When configured, rate limits survive gateway restarts and work across
# multiple instances behind a load balancer.
# Default: redis://redis:6379/0 (works with Docker Compose out of the box).
RATE_LIMIT_REDIS_URL=redis://redis:6379/0

# Optional. Default requests per minute per API key. Default is 60.
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ── Gateway Settings ───────────────────────────────────
# Optional. Port the gateway listens on. Default is 8080.
GATEWAY_PORT=8080

# Optional. Log verbosity: debug, info, warning, error. Default is info.
LOG_LEVEL=info

# Optional. Log output format: json (default) or console (human-readable).
LOG_FORMAT=json

# ── CORS ──────────────────────────────────────────────
# Optional. Comma-separated allowed origins.
CORS_ORIGINS=http://localhost:8080,https://localhost

# ── PII Scrubbing ────────────────────────────────────
# What to do when the scrubber fails: fail_closed (503) or fail_open (forward unscrubbed).
SCRUBBER_FAILURE_MODE=fail_closed

# Optional. Enable French NLP model for bilingual PII detection (~500 MB extra RAM).
ENABLE_FRENCH_NLP=false

# ── Alerts (optional) ────────────────────────────────
# Webhook URL for alerts (PII spikes, budget warnings, chain failures).
ALERT_WEBHOOK_URL=
# Email address for alert notifications.
ALERT_EMAIL=

# ── Provincial Privacy Framework ──────────────────────
# Optional. Your province code: BC, AB, ON, or QC.
# When set, the gateway maps PII detections to your province's privacy law
# (BC FIPPA, Alberta FOIPP, Ontario MFIPPA, or Quebec Law 25).
# The /frameworks endpoint returns the active framework configuration.
PROVINCE=

# ── Admin Accounts (v1.1) ─────────────────────────────
# Optional. Bootstrap the first admin account on startup.
# If both are set and no admin with this email exists, the account is created automatically.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── LDAP / Active Directory (v1.1) ────────────────────
# Optional. Enable LDAP authentication for staff key provisioning.
# When enabled, staff can authenticate with AD credentials instead of manual API keys.
LDAP_ENABLED=false
LDAP_SERVER=
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_STARTTLS=true
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# LDAP search filter. {username} is replaced with the login username.
LDAP_USER_FILTER=(sAMAccountName={username})
# LDAP attribute that maps to the gateway department field.
LDAP_DEPT_ATTRIBUTE=department
